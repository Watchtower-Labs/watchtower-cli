{
	"name": "@watchtower/cli",
	"version": "0.1.0",
	"description": "Terminal UI for viewing ADK agent traces",
	"license": "MIT",
	"author": "Watchtower Contributors",
	"repository": {
		"type": "git",
		"url": "https://github.com/Watchtower-Labs/watchtower-cli.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/Watchtower-Labs/watchtower-cli#readme",
	"bugs": {
		"url": "https://github.com/Watchtower-Labs/watchtower-cli/issues"
	},
	"keywords": [
		"cli",
		"terminal",
		"adk",
		"agent",
		"observability",
		"tracing",
		"google-adk",
		"llm",
		"ai-agents",
		"ink",
		"react"
	],
	"bin": {
		"watchtower": "dist/index.js"
	},
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "tsc --project tsconfig.test.json && ava dist/**/*.test.js",
		"test:stress": "tsc --project tsconfig.test.json && WATCHTOWER_STRESS=1 ava dist/**/*.test.js --match='*stress*'",
		"test:watch": "ava --watch dist/**/*.test.js",
		"lint": "prettier --check . && xo",
		"lint:fix": "prettier --write . && xo --fix",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"files": [
		"dist",
		"README.md"
	],
	"dependencies": {
		"chalk": "^5.3.0",
		"ink": "^4.4.1",
		"react": "^18.2.0",
		"uuid": "^9.0.0",
		"yargs": "^17.7.2"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/node": "^20.0.0",
		"@types/react": "^18.2.0",
		"@types/uuid": "^9.0.0",
		"@types/yargs": "^17.0.0",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"ts-node": "^10.9.1",
		"typescript": "^5.3.0",
		"xo": "^0.53.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"ava": {
		"files": [
			"dist/**/*.test.js"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off",
			"unicorn/expiring-todo-comments": "off",
			"@typescript-eslint/naming-convention": "off",
			"react/prefer-read-only-props": "off",
			"unicorn/prevent-abbreviations": "off",
			"@typescript-eslint/consistent-type-definitions": "off",
			"unicorn/no-array-push-push": "off",
			"@typescript-eslint/ban-types": "off",
			"unicorn/switch-case-braces": "off",
			"@typescript-eslint/padding-line-between-statements": "off",
			"@typescript-eslint/restrict-template-expressions": "off",
			"react/jsx-sort-props": "off",
			"unicorn/filename-case": "off",
			"unicorn/numeric-separators-style": "off",
			"unicorn/prefer-number-properties": "off",
			"react/boolean-prop-naming": "off",
			"@typescript-eslint/no-implicit-any-catch": "off",
			"n/prefer-global/process": "off",
			"unicorn/text-encoding-identifier-case": "off",
			"@typescript-eslint/no-inferrable-types": "off",
			"unicorn/catch-error-name": "off",
			"@typescript-eslint/prefer-readonly": "off",
			"react/jsx-curly-brace-presence": "off",
			"ava/no-ignored-test-files": "off",
			"unicorn/better-regex": "off",
			"react/no-unused-prop-types": "off",
			"@typescript-eslint/prefer-nullish-coalescing": "off",
			"react/jsx-no-useless-fragment": "off",
			"@typescript-eslint/no-confusing-void-expression": "off",
			"@typescript-eslint/no-unnecessary-type-assertion": "off",
			"capitalized-comments": "off",
			"object-shorthand": "off",
			"prefer-destructuring": "off",
			"no-promise-executor-return": "off",
			"@typescript-eslint/switch-exhaustiveness-check": "warn",
			"unicorn/no-for-loop": "off",
			"eslint-comments/no-unused-disable": "off",
			"unicorn/no-zero-fractions": "off",
			"unicorn/prefer-switch": "off",
			"react/no-unescaped-entities": "off",
			"unicorn/no-useless-switch-case": "off",
			"@typescript-eslint/parameter-properties": "off",
			"@typescript-eslint/no-floating-promises": "warn",
			"@typescript-eslint/no-unsafe-assignment": "off",
			"n/prefer-global/buffer": "off",
			"no-constant-condition": "warn",
			"no-await-in-loop": "off",
			"unicorn/no-process-exit": "off",
			"unicorn/no-hex-escape": "off",
			"no-else-return": "off",
			"unicorn/no-array-for-each": "off",
			"unicorn/prefer-optional-catch-binding": "off",
			"@typescript-eslint/member-ordering": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
